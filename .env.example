# Credential-free Milestones 1–3
CURLCAST_MODE=mock
NEXT_PUBLIC_CURLCAST_MODE=mock
MOCK_ORGANIZER_KEY=change-me-in-production
ROLE_TOKEN_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=https://curlstreamer.vercel.app
GOOGLE_AUTH_ENABLED=false
SPONSOR_MAX_FILE_MB=12
SPONSOR_SAFETY_TIMEOUT_MINUTES=30

# Milestones 4–8 (unused in mock mode)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com/live2
YOUTUBE_STREAM_KEY=
TOKEN_ENCRYPTION_KEY=
GOOGLE_YOUTUBE_CLIENT_ID=
GOOGLE_YOUTUBE_CLIENT_SECRET=
GOOGLE_YOUTUBE_REDIRECT_URI=https://curlstreamer.vercel.app/api/settings/youtube/oauth/callback
YOUTUBE_CREDENTIAL_ENCRYPTION_KEY=

# Optional administrator-only Stripe sandbox. Live keys are always rejected.
STRIPE_TEST_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_TEST_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional CurlCoach rollout. Requires migration 0058, team entitlement and coach grant.
CURLCOACH_ENABLED=false
# Local development only; never enable the lab for deployment.
CURLCOACH_LOCAL_LAB=false
CURLCOACH_LAB_SECRET=

# Nonrenewing season passes. Leave mode empty until the database migrations and
# matching Stripe prices/webhook have been verified. Test is administrator-only.
STRIPE_SEASON_MODE=
# Optional: falls back to existing STRIPE_SECRET_KEY in test mode only.
STRIPE_SEASON_TEST_SECRET_KEY=
STRIPE_SEASON_TEST_BASE_PRICE=
STRIPE_SEASON_TEST_COACH_PRICE=
# Optional: reuse STRIPE_WEBHOOK_SECRET with the existing sandbox destination.
STRIPE_SEASON_TEST_WEBHOOK_SECRET=
STRIPE_SEASON_LIVE_SECRET_KEY=
STRIPE_SEASON_LIVE_BASE_PRICE=
STRIPE_SEASON_LIVE_COACH_PRICE=
STRIPE_SEASON_LIVE_WEBHOOK_SECRET=
